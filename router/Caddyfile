{
	auto_https off
	admin off
}

:8080 {
	handle /.well-known/oauth-protected-resource {
		header Content-Type application/json
		respond `{"resource":"https://paperlessmcp-oauth.mchristoffers.dev/mcp","authorization_servers":["https://paperlessmcp-oauth.mchristoffers.dev/dex"]}` 200
	}

	handle /dex/* {
		reverse_proxy dex:5556
	}

	handle /mcp* {
		reverse_proxy oauth2-proxy:4180
	}

	handle {
		respond 404
	}
}
